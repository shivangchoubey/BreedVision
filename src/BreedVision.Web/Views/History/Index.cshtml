@model BreedVision.Web.Models.ViewModels.HistoryFilterViewModel
@{
    ViewData["Title"] = "Prediction History";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="display-6 fw-bold text-dark mb-1"><i class="bi bi-clock-history text-success me-2"></i> Prediction History Log</h2>
            <p class="text-secondary mb-0">Audit record of all image classifications processed and persisted in the local SQL database.</p>
        </div>
        <a asp-controller="Breed" asp-action="Identify" class="btn btn-success rounded-pill px-4 fw-semibold">
            <i class="bi bi-camera me-1"></i> New Classification
        </a>
    </div>

    <!-- Filter Bar Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Search Inferences</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-secondary"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by file name or notes..." value="@Model.SearchTerm" />
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Filter by Breed</label>
                    <select name="breed" class="form-select">
                        <option value="">All Breeds</option>
                        @foreach (var b in Model.AvailableBreeds)
                        {
                            <option value="@b" selected="@(Model.BreedFilter == b)">@b</option>
                        }
                    </select>
                </div>

                <div class="col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Species</label>
                    <select name="species" class="form-select">
                        <option value="">All Species</option>
                        <option value="Cattle" selected="@(Model.SpeciesFilter == "Cattle")">Cattle</option>
                        <option value="Buffalo" selected="@(Model.SpeciesFilter == "Buffalo")">Buffalo</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-pill">
                        <i class="bi bi-filter me-1"></i> Apply Filters
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.BreedFilter) || !string.IsNullOrEmpty(Model.SpeciesFilter) || Model.LowConfidenceOnly.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-danger rounded-pill" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
                    }
                </div>

                <div class="col-12 mt-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="lowConfidenceOnly" value="true" id="lowConfSwitch" @(Model.LowConfidenceOnly == true ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label small text-secondary" for="lowConfSwitch">
                            Show only Low-Confidence / Out-of-Distribution (OOD) detections
                        </label>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- History Results Table -->
    @if (!Model.Records.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="fs-1 text-secondary mb-2"><i class="bi bi-inbox"></i></div>
            <h5 class="fw-bold">No prediction records found</h5>
            <p class="text-secondary small mb-3">No images have been classified matching your search criteria yet.</p>
            <div>
                <a asp-controller="Breed" asp-action="Identify" class="btn btn-success rounded-pill px-4">Identify an Image Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">Image</th>
                            <th>Original File</th>
                            <th>Predicted Breed</th>
                            <th>Confidence</th>
                            <th>Latency</th>
                            <th>Timestamp</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Records)
                        {
                            <tr>
                                <td class="ps-4" style="width: 70px;">
                                    <img src="@item.SavedImagePath" alt="@item.PredictedBreedName" class="rounded object-fit-cover shadow-2xs" style="width: 50px; height: 50px;" onerror="this.src='/images/placeholder.png';" />
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 200px;" title="@item.OriginalFileName">
                                        @item.OriginalFileName
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.UserNotes))
                                    {
                                        <small class="text-secondary text-truncate d-block" style="max-width: 200px;" title="@item.UserNotes">
                                            <i class="bi bi-sticky me-1"></i> @item.UserNotes
                                        </small>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.PredictedBreedName</div>
                                    <span class="badge @(item.Breed?.Species == "Buffalo" ? "badge-buffalo" : "badge-cattle") py-0">
                                        @(item.Breed?.Species ?? "Bovine")
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsLowConfidence)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @item.ConfidenceScore.ToString("F1")% (OOD)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">
                                            @item.ConfidenceScore.ToString("F1")%
                                        </span>
                                    }
                                </td>
                                <td class="small text-secondary">
                                    @item.InferenceTimeMs ms
                                </td>
                                <td class="small text-secondary">
                                    @item.PredictionTimestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Breed" asp-action="Result" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="View Result Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this prediction record?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete record">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <small class="text-secondary">
                        Showing page @Model.Page of @Model.TotalPages (@Model.TotalRecords total records)
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.Page - 1)" 
                                   asp-route-search="@Model.SearchTerm" 
                                   asp-route-breed="@Model.BreedFilter" 
                                   asp-route-species="@Model.SpeciesFilter" 
                                   asp-route-lowConfidenceOnly="@Model.LowConfidenceOnly">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(Model.Page == p ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@p" 
                                       asp-route-search="@Model.SearchTerm" 
                                       asp-route-breed="@Model.BreedFilter" 
                                       asp-route-species="@Model.SpeciesFilter" 
                                       asp-route-lowConfidenceOnly="@Model.LowConfidenceOnly">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.Page + 1)" 
                                   asp-route-search="@Model.SearchTerm" 
                                   asp-route-breed="@Model.BreedFilter" 
                                   asp-route-species="@Model.SpeciesFilter" 
                                   asp-route-lowConfidenceOnly="@Model.LowConfidenceOnly">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>

