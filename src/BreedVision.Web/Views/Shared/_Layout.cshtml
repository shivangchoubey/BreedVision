<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BreedVision | Bovine Breed Recognition</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-gradient shadow-sm border-bottom border-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-shield-check" style="color: #e0b87e;"></i>
                    </span>
                    <span class="brand-name text-white">Breed<span style="color: #e0b87e;">Vision</span></span>
                    <span class="badge fs-7 px-2 py-1 ms-1" style="background-color: rgba(171, 190, 153, 0.22); color: #e0b87e; border: 1px solid rgba(171, 190, 153, 0.4);">AI 41-Class</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Breed" ? "active" : "")" asp-controller="Breed" asp-action="Identify">
                                <i class="bi bi-camera-fill me-1"></i> Identify Breed
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Catalog" ? "active" : "")" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-journal-bookmark-fill me-1"></i> Breed Encyclopedia
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "History" ? "active" : "")" asp-controller="History" asp-action="Index">
                                <i class="bi bi-clock-history me-1"></i> History Log
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> About & Model
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Breed" asp-action="Identify" class="btn btn-success btn-sm px-3 fw-semibold shadow-sm rounded-pill">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Classify Image
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-auto border-top border-secondary border-opacity-25">
        <div class="container">
            <div class="row gy-3 align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <span class="fw-bold fs-5 text-white">Breed<span style="color: #e0b87e;">Vision</span></span>
                        <span class="text-secondary">|</span>
                        <small class="text-light-emphasis">Indigenous Cattle & Buffalo Breed Recognition System</small>
                    </div>
                    <small class="text-secondary d-block">
                        Engineered with ASP.NET Core MVC, ONNX Runtime (ResNet-50 Metric Learning), and ICAR-NBAGR Breed Standards.
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3 small text-secondary">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary hover-white">Dashboard</a>
                        <span>•</span>
                        <a asp-controller="Breed" asp-action="Identify" class="text-decoration-none text-secondary hover-white">Identify</a>
                        <span>•</span>
                        <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-secondary hover-white">Encyclopedia</a>
                        <span>•</span>
                        <a asp-controller="Home" asp-action="About" class="text-decoration-none text-secondary hover-white">Model Specs</a>
                    </div>
                    <small class="text-secondary mt-1 d-block">&copy; 2026 BreedVision Research Project. Local & Offline Capable.</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
